<Window x:Class="TypePaste.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TypePaste.Views"
        xmlns:conv="clr-namespace:TypePaste.Converters"
        Title="TypePaste"
        AutomationProperties.AutomationId="TypePasteMainWindow"
        Icon="/Assets/TypePaste.ico"
        Style="{StaticResource AppWindowStyle}"
        Width="1000" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12,6,14,6" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusForeground" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Stopped">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Error">
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Pulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.55" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ================================================================ Main content -->
        <Grid x:Name="MainContent" Margin="28,18,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="/Assets/TypePaste-256.png" Width="58" Height="58" Margin="-8,-4,6,-4"
                       RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TypePaste" Style="{StaticResource TitleText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding StartHotkeyParts}" ItemTemplate="{StaticResource KeycapItemTemplate}"
                                      ItemsPanel="{StaticResource HorizontalItemsPanel}" Focusable="False"
                                      AutomationProperties.AutomationId="StartHotkeyKeys" />
                        <TextBlock Text="Start typing" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,18,0" />
                        <ItemsControl ItemsSource="{Binding StopHotkeyParts}" ItemTemplate="{StaticResource KeycapItemTemplate}"
                                      ItemsPanel="{StaticResource HorizontalItemsPanel}" Focusable="False"
                                      AutomationProperties.AutomationId="StopHotkeyKeys" />
                        <TextBlock Text="Stop" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,2" Margin="14,0,0,0"
                                VerticalAlignment="Center" Visibility="{Binding HotkeysPaused, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Hotkeys paused" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center" AutomationProperties.AutomationId="StatusPill">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13"
                                       Style="{StaticResource StatusForeground}" AutomationProperties.AutomationId="StatusText" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="8,0,-6,0" Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings" AutomationProperties.AutomationId="SettingsButton" />
                </StackPanel>
            </Grid>

            <!-- Editor card -->
            <Grid Grid.Row="1" Margin="0,18,0,0">
                <Border Style="{StaticResource CardShadow}" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Grid Margin="18,10,10,6">
                            <TextBlock Text="Text to type" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFileCommand}" ToolTip="Load a text file (Ctrl+O)"
                                        AutomationProperties.AutomationId="OpenFileButton">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,0,7,0" />
                                        <TextBlock Text="Open" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding PasteCommand}" ToolTip="Paste from the clipboard"
                                        AutomationProperties.AutomationId="PasteButton">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE77F;" Margin="0,0,7,0" />
                                        <TextBlock Text="Paste" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding ClearCommand}" ToolTip="Clear the text (Ctrl+Z to undo)"
                                        AutomationProperties.AutomationId="ClearButton">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" Margin="0,0,7,0" />
                                        <TextBlock Text="Clear" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1" Background="{DynamicResource SurfaceAltBrush}">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{Binding PlaceholderText}" Margin="20,16,20,0" FontSize="15"
                                           Foreground="{DynamicResource PlaceholderBrush}" TextWrapping="Wrap" IsHitTestVisible="False"
                                           FontFamily="{Binding EditorFontFamily}" />
                                <TextBox x:Name="Editor" Style="{StaticResource EditorTextBox}" FontFamily="{Binding EditorFontFamily}"
                                         AllowDrop="True" UndoLimit="200"
                                         AutomationProperties.AutomationId="EditorTextBox" AutomationProperties.Name="Text to type" />
                            </Grid>
                        </Border>

                        <!-- Footer: statistics -->
                        <Grid Grid.Row="2" Margin="18,10,18,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CharacterCountText}" Style="{StaticResource CaptionText}" FontWeight="SemiBold"
                                           AutomationProperties.AutomationId="CharacterCount" />
                                <TextBlock Text="·" Style="{StaticResource CaptionText}" Margin="8,0" />
                                <TextBlock Text="{Binding WordCountText}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="WordCount" />
                                <TextBlock Text="·" Style="{StaticResource CaptionText}" Margin="8,0" />
                                <TextBlock Text="{Binding LineCountText}" Style="{StaticResource CaptionText}" AutomationProperties.AutomationId="LineCount" />
                                <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="8,1" Margin="12,0,0,0"
                                        Visibility="{Binding ControlCharacterWarning, Converter={StaticResource NotEmptyToVisibility}}">
                                    <TextBlock Text="{Binding ControlCharacterWarning}" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding EstimateText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="EstimateText" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Bottom">
                    <TextBlock Text="SPEED" Style="{StaticResource OverlineText}" Margin="2,0,0,6" />
                    <Border Style="{StaticResource SegmentPanel}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Instant" GroupName="MainSpeed"
                                         IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Instant}"
                                         ToolTip="Maximum speed: types as fast as the target app accepts keystrokes."
                                         AutomationProperties.AutomationId="SpeedInstant" />
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Fast" GroupName="MainSpeed"
                                         IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Fast}"
                                         ToolTip="About 500 characters per second."
                                         AutomationProperties.AutomationId="SpeedFast" />
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Steady" GroupName="MainSpeed"
                                         IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Steady}"
                                         ToolTip="About 65 characters per second. Good for apps and games that miss fast input."
                                         AutomationProperties.AutomationId="SpeedSteady" />
                            <RadioButton Style="{StaticResource SegmentButton}" Content="Custom" GroupName="MainSpeed"
                                         IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}"
                                         ToolTip="Your own delay between characters (set it in Settings)."
                                         AutomationProperties.AutomationId="SpeedCustom" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="22,0,22,2" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"
                               MaxHeight="36" AutomationProperties.AutomationId="StatusDetail" />
                    <ProgressBar Style="{StaticResource SlimProgressBar}" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,4"
                                 Visibility="{Binding IsTyping, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.AutomationId="TypingProgress" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding TestCommand}" Height="42"
                            ToolTip="Type your text into a built-in test pad and verify it arrived exactly."
                            AutomationProperties.AutomationId="TestButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" Margin="0,0,8,0" />
                            <TextBlock Text="Test typing" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartStopCommand}" Height="42" MinWidth="132" Margin="10,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}"
                            ToolTip="Count down, then type into the text field you click."
                            AutomationProperties.AutomationId="StartButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,8,0" />
                            <TextBlock Text="Start" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding StartStopCommand}" Height="42" MinWidth="132" Margin="10,0,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.AutomationId="StopButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" Margin="0,0,8,0" />
                            <TextBlock Text="Stop" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================================================================ Settings sheet -->
        <Grid x:Name="SettingsLayer" Visibility="Collapsed">
            <Border x:Name="Scrim" Background="{DynamicResource ScrimBrush}" Opacity="0" MouseLeftButtonDown="Scrim_MouseLeftButtonDown" />
            <Grid x:Name="SettingsSheet" HorizontalAlignment="Right" Width="460">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SheetOffset" X="480" />
                </Grid.RenderTransform>
                <!-- Shadow on an empty sibling keeps ClearType text in the panel. -->
                <Border Background="{DynamicResource WindowBackgroundBrush}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.25" Color="#000000" />
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource WindowBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
                    <views:SettingsView DataContext="{Binding Settings}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
