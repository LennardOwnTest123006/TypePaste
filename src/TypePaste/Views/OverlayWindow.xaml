<Window x:Class="TypePaste.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypePaste status"
        AutomationProperties.AutomationId="TypePasteOverlay"
        Style="{StaticResource AppWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False">
    <Grid x:Name="Root" Margin="18,10,18,26" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>

        <Border CornerRadius="16" Background="{DynamicResource OverlayBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.28" Color="#0A0F2E" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" Background="{DynamicResource OverlayBackgroundBrush}" BorderBrush="{DynamicResource OverlayBorderBrush}"
                BorderThickness="1" Padding="14,12,18,12" MinWidth="320" MaxWidth="480">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,12,0">
                    <Image x:Name="Logo" Source="/Assets/TypePaste-256.png" Width="44" Height="44" Margin="-2"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Border x:Name="Badge" CornerRadius="20" Visibility="Collapsed">
                        <TextBlock x:Name="BadgeGlyph" Style="{StaticResource IconText}" FontSize="18" HorizontalAlignment="Center" />
                    </Border>
                    <Border x:Name="CountdownBadge" CornerRadius="20" Background="{DynamicResource AccentGradientBrush}" Visibility="Collapsed"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="CountdownScale" />
                        </Border.RenderTransform>
                        <TextBlock x:Name="CountdownText" FontSize="20" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="OverlayTitle" />
                    <TextBlock x:Name="DetailText" Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" AutomationProperties.AutomationId="OverlayDetail" />
                    <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgressBar}" Margin="0,9,0,1" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
