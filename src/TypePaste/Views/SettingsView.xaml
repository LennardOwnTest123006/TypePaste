<UserControl x:Class="TypePaste.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TypePaste.Controls"
             xmlns:conv="clr-namespace:TypePaste.Converters"
             AutomationProperties.AutomationId="SettingsPanel">
    <UserControl.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="18,16,18,4" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="SettingBlock" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource OverlineText}">
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>

        <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="26,18,16,14">
            <TextBlock Text="Settings" Style="{StaticResource TitleText}" FontSize="20" VerticalAlignment="Center" />
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="14" HorizontalAlignment="Right"
                    Command="{Binding CloseCommand}" ToolTip="Close settings (Esc)"
                    AutomationProperties.Name="Close settings" AutomationProperties.AutomationId="SettingsCloseButton" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,18,8" Focusable="False">
            <StackPanel>
                <!-- ======================================================== Typing -->
                <TextBlock Text="TYPING" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Speed" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Instant types as fast as the target app accepts input. Slower modes help apps and games that miss keystrokes."
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                            <Border Style="{StaticResource SegmentPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Instant" GroupName="SettingsSpeed"
                                                 IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Instant}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Fast" GroupName="SettingsSpeed"
                                                 IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Fast}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Steady" GroupName="SettingsSpeed"
                                                 IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Steady}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Custom" GroupName="SettingsSpeed"
                                                 IsChecked="{Binding Speed, Converter={StaticResource EnumEquals}, ConverterParameter=Custom}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingBlock}" Visibility="{Binding IsCustomSpeed, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Delay between characters" Style="{StaticResource SettingLabel}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" SmallChange="0.5" LargeChange="5" VerticalAlignment="Center"
                                        Value="{Binding CustomDelayMs}" AutomationProperties.AutomationId="CustomDelaySlider" />
                                <TextBox Grid.Column="1" Style="{StaticResource InputTextBox}" Width="64" Margin="14,0,6,0" TextAlignment="Right"
                                         Text="{Binding CustomDelayMs, StringFormat={}{0:0.#}, UpdateSourceTrigger=LostFocus}"
                                         AutomationProperties.AutomationId="CustomDelayInput" />
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding CustomDelayDescription}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Pause after each line break" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Gives editors and chat apps time to process new lines." Style="{StaticResource CaptionText}" Margin="0,2,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="1000" SmallChange="10" LargeChange="50" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding LineBreakDelayMs}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding LineBreakDelayMs, StringFormat={}{0} ms}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Line breaks" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Shift+Enter adds new lines in chat apps (Teams, Slack, Discord, WhatsApp) without sending every line."
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                            <Border Style="{StaticResource SegmentPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Enter" GroupName="LineBreak"
                                                 IsChecked="{Binding LineBreak, Converter={StaticResource EnumEquals}, ConverterParameter=Enter}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Shift+Enter" GroupName="LineBreak"
                                                 IsChecked="{Binding LineBreak, Converter={StaticResource EnumEquals}, ConverterParameter=ShiftEnter}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Tabs" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="A tab character keeps the text exact. The Tab key may move to the next field in forms."
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                            <Border Style="{StaticResource SegmentPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Tab character" GroupName="Tabs"
                                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=Character}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Tab key" GroupName="Tabs"
                                                 IsChecked="{Binding Tab, Converter={StaticResource EnumEquals}, ConverterParameter=TabKey}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Input method" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Unicode works everywhere with every character. Keyboard layout presses real keys of your layout for apps that ignore Unicode input (some games and remote desktops)."
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,10" />
                            <Border Style="{StaticResource SegmentPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Unicode" GroupName="InputMethod"
                                                 IsChecked="{Binding InputMethod, Converter={StaticResource EnumEquals}, ConverterParameter=Unicode}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Keyboard layout" GroupName="InputMethod"
                                                 IsChecked="{Binding InputMethod, Converter={StaticResource EnumEquals}, ConverterParameter=KeyboardLayout}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StopOnFocusChange}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Stop when another window becomes active" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Prevents text from landing in the wrong app if you switch windows while typing."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ======================================================== Hotkeys -->
                <TextBlock Text="HOTKEYS" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start typing" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Works in every app. Click to change." Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <controls:HotkeyBox x:Name="StartHotkeyBox" Grid.Column="1" Gesture="{Binding StartHotkey, Mode=OneWay}"
                                                AutomationProperties.AutomationId="StartHotkeyBox" AutomationProperties.Name="Start typing hotkey" />
                        </Grid>
                        <TextBlock Text="{Binding StartHotkeyError}" Style="{StaticResource ErrorText}" Margin="0,-6,0,12"
                                   Visibility="{Binding StartHotkeyError, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Stop typing" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Only active while TypePaste is typing." Style="{StaticResource CaptionText}" />
                            </StackPanel>
                            <controls:HotkeyBox x:Name="StopHotkeyBox" Grid.Column="1" Gesture="{Binding StopHotkey, Mode=OneWay}"
                                                AutomationProperties.AutomationId="StopHotkeyBox" AutomationProperties.Name="Stop typing hotkey" />
                        </Grid>
                        <TextBlock Text="{Binding StopHotkeyError}" Style="{StaticResource ErrorText}" Margin="0,-6,0,12"
                                   Visibility="{Binding StopHotkeyError, Converter={StaticResource NotEmptyToVisibility}}" />

                        <Button Style="{StaticResource LinkButton}" Content="Reset to F6 and Esc" Command="{Binding ResetHotkeysCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,18" />

                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Start button countdown" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Time to click into the target field after pressing Start." Style="{StaticResource CaptionText}" Margin="0,2,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="10" SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding StartCountdownSeconds}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding StartCountdownSeconds, StringFormat={}{0} s}" Style="{StaticResource CaptionText}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeOnStart}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Minimize TypePaste when Start is clicked" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Returns focus to the app you used before TypePaste." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HotkeysPaused}" Margin="0,0,0,16"
                                  AutomationProperties.AutomationId="PauseHotkeysToggle">
                            <StackPanel>
                                <TextBlock Text="Pause hotkeys" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Temporarily gives the start hotkey back to other apps." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ======================================================== Appearance -->
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Theme" Style="{StaticResource SettingLabel}" Margin="0,0,0,10" />
                            <Border Style="{StaticResource SegmentPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="System" GroupName="Theme"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Light" GroupName="Theme"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"
                                                 AutomationProperties.AutomationId="ThemeLight" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Dark" GroupName="Theme"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"
                                                 AutomationProperties.AutomationId="ThemeDark" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Style="{StaticResource SettingBlock}">
                            <TextBlock Text="Editor font" Style="{StaticResource SettingLabel}" Margin="0,0,0,10" />
                            <Border Style="{StaticResource SegmentPanel}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Sans" GroupName="EditorFont"
                                                 IsChecked="{Binding EditorFont, Converter={StaticResource EnumEquals}, ConverterParameter=Sans}" />
                                    <RadioButton Style="{StaticResource SegmentButton}" Content="Monospace" GroupName="EditorFont"
                                                 IsChecked="{Binding EditorFont, Converter={StaticResource EnumEquals}, ConverterParameter=Monospace}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOverlay}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Show progress on screen while typing" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="A small card at the top of the screen shows progress and results. It never takes focus."
                                           Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding RememberText}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Remember text between sessions" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Saved only on this PC. Turn off for sensitive text." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ======================================================== Windows -->
                <TextBlock Text="WINDOWS" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchAtStartup}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Start TypePaste when I sign in" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Starts quietly in the notification area." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimizedToTray}" Margin="0,0,0,16"
                                  AutomationProperties.AutomationId="StartMinimizedToggle">
                            <StackPanel>
                                <TextBlock Text="Launch minimized to the system tray" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="The hotkey works right away; open the window from the tray icon." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseToTray}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Keep running in the tray when the window is closed" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Use Exit in the tray menu to quit completely." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- ======================================================== About -->
                <TextBlock Text="ABOUT" Style="{StaticResource SectionHeader}" />
                <Border Style="{StaticResource SettingsCard}" Padding="18,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="/Assets/TypePaste-256.png" Width="56" Height="56" Margin="-6,-4,10,0" VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource SettingLabel}">
                                <Run Text="TypePaste" />
                                <Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                       Text="Runs entirely on this PC — no account, no internet connection and no cloud service. Protected fields and apps that run as administrator are respected." />
                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0" Foreground="{DynamicResource WarningBrush}"
                                       Text="TypePaste is running as administrator."
                                       Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}}" />
                            <Button Style="{StaticResource LinkButton}" Content="Open settings folder" Command="{Binding OpenDataFolderCommand}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
