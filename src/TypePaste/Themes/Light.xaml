<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- TypePaste light palette. Keys must match Dark.xaml. -->
    <Color x:Key="TitleBarColor">#F3F5FB</Color>
    <Color x:Key="ShadowColor">#1A2250</Color>
    <Color x:Key="AccentColor">#3563F0</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F5FB" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F8F9FD" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EEF1FA" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E3E8F6" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E6F2" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#CBD2E6" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#141A33" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#566081" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A93B0" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9AA3BF" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3563F0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B55DA" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#2A55D6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F3563F0" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#803563F0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#3563F0" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#2F6BFF" />
        <GradientStop Offset="1" Color="#7A4DFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#255EF0" />
        <GradientStop Offset="1" Color="#6B3DF2" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SuccessBrush" Color="#12A150" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F12A150" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C27803" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#24E3A008" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D92D3A" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#C0222F" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1FD92D3A" />

    <LinearGradientBrush x:Key="KeycapBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2A3F9E" />
        <GradientStop Offset="1" Color="#15205E" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeycapFaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="1" Color="#E4EAFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeycapTextBrush" Color="#1B2A78" />

    <SolidColorBrush x:Key="SegmentBackgroundBrush" Color="#EAEEF8" />
    <SolidColorBrush x:Key="SegmentSelectedBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SegmentSelectedTextBrush" Color="#1D3FB8" />

    <SolidColorBrush x:Key="ToggleOffBrush" Color="#C3CAE0" />
    <SolidColorBrush x:Key="ToggleKnobBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#5A6A8AB8" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8A5A6A8A" />

    <SolidColorBrush x:Key="ScrimBrush" Color="#590B1030" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#D5DCEE" />
</ResourceDictionary>
