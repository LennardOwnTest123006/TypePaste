<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TypePaste</AssemblyName>
    <RootNamespace>TypePaste</RootNamespace>
    <StartupObject>TypePaste.Program</StartupObject>
    <ApplicationIcon>Assets\TypePaste.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>TypePaste</AssemblyTitle>
    <Description>TypePaste types prepared text into any application with one hotkey.</Description>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Startup performance: tiered PGO/quick JIT are defaults; keep invariant culture off so numbers follow the user's locale. -->
    <TieredPGO>true</TieredPGO>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Smaller download: remove unused .NET library code when publishing (the installer shrinks from ~42 MB to ~26 MB).
    "partial" only trims the framework libraries that are marked trimmable; the WPF assemblies and TypePaste itself
    are kept whole, so XAML, data binding and reflection keep working. The switches below keep the runtime features
    WPF and TypePaste rely on that trimming would otherwise turn off.
  -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is compiled as a page so Program.Main can handle single-instance and splash logic first. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\TypePaste.ico" />
    <Resource Include="Assets\TypePaste-256.png" />
    <Resource Include="Assets\Splash.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF projects leave System.IO out of the implicit usings (Path clashes with System.Windows.Shapes.Path). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TypePaste.Core\TypePaste.Core.csproj" />
  </ItemGroup>

</Project>
